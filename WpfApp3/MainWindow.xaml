<Window x:Class="InheritanceDemo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Inheritance Demo" Height="300" Width="400">

    <StackPanel Margin="20">

        <TextBlock Text="Име:"/>
        <TextBox x:Name="NameBox" Margin="0,5,0,10"/>

        <TextBlock Text="Оценка:"/>
        <TextBox x:Name="GradeBox" Margin="0,5,0,10"/>

        <Button Content="Създай ученик"
                Click="CreateStudentButton_Click"
                Margin="0,5,0,10"/>

        <TextBlock x:Name="ResultTextBlock"
                   FontSize="18"/>

    </StackPanel>
</Window>

